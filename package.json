{
  "name": "ramos-gestao",
  "productName": "Ramos Gestão",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma interna de gestão da Ramos Importação e Comércio",
  "author": "Ramos Importação e Comércio",
  "license": "UNLICENSED",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "dist:win": "electron-vite build && electron-builder --win --publish never"
  },
  "dependencies": {
    "better-sqlite3-multiple-ciphers": "^13.0.3",
    "decimal.js": "^10.6.0",
    "hash-wasm": "^4.12.0"
